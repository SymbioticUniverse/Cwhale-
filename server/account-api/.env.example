# Copy to /etc/cwhale-account-api.env on the server and chmod 600.
CWH_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CWH_AUTH_DB=/var/lib/cwhale-account/accounts.sqlite3

# SMTP with STARTTLS (usually 587) or implicit TLS (465).
CWH_SMTP_HOST=smtp.example.com
CWH_SMTP_PORT=587
CWH_SMTP_USER=account@example.com
CWH_SMTP_PASSWORD=REPLACE_WITH_MAIL_PROVIDER_APP_PASSWORD
CWH_SMTP_FROM=account@example.com
CWH_SMTP_FROM_NAME=Cwhale
